{
  "manifest_version": 3,
  "name": "Snaz Karaoke – ตัดเสียงร้อง YouTube",
  "version": "0.2.0",
  "description": "ตัดเสียงนักร้องออกจากวิดีโอ YouTube แบบเรียลไทม์ พร้อมเนื้อเพลงตามจังหวะ สำหรับร้องคาราโอเกะ",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lrclib.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Snaz Karaoke",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "settings.js",
        "lyrics-core.js",
        "content.js",
        "lyrics.js"
      ],
      "css": [
        "lyrics.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vocal-remover-worklet.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
